---
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";
import {
  defaultLang,
  languages,
  localizePath,
  ogLocales,
  stripLang,
  useAstroTranslations,
} from "@/i18n";
import "../styles/globals.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** For utility pages like 404: adds robots noindex and drops canonical/hreflang. */
  noindex?: boolean;
}

const { lang, t } = useAstroTranslations(Astro.url);

const {
  title = t("meta.title"),
  description = t("meta.description"),
  image = "/logo_white.png",
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL("https://surpricebot.com");
// Same page in every language, e.g. "/" for "/", "/ru/" and "/pl/".
const basePath = stripLang(Astro.url.pathname) || "/";
const isHome = basePath === "/";
const urlFor = (l: (typeof languages)[number]) => new URL(localizePath(l, basePath), site).toString();
const canonicalURL = urlFor(lang);
const absoluteImageURL = new URL(image, site).toString();
const homeURL = new URL("/", site).toString();

const organizationJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "SurPrice Bot",
  url: homeURL,
  logo: new URL("/SPBLogo.svg", site).toString(),
  sameAs: ["https://t.me/sur_price_bot"],
};

const softwareAppJsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "SurPrice Bot",
  alternateName: ["SurPrice", "@sur_price_bot"],
  applicationCategory: "UtilitiesApplication",
  applicationSubCategory: "Price tracker",
  operatingSystem: "Telegram",
  url: homeURL,
  installUrl: "https://t.me/sur_price_bot",
  image: absoluteImageURL,
  description,
  inLanguage: [...languages],
  isAccessibleForFree: true,
  featureList: [
    "Price drop alerts in Telegram",
    "Back-in-stock and availability alerts",
    "Screenshot confirmation of the tracked price",
    "Competitor price monitoring for sellers",
    "Free plan: 3 trackers checked every 5 hours",
    "Basic plan: 10 trackers checked every 2.5 hours",
    "Pro plan: 25 trackers checked every hour",
  ],
  offers: {
    "@type": "Offer",
    name: "Free",
    price: "0",
    priceCurrency: "USD",
  },
};

const webSiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "SurPrice Bot",
  url: canonicalURL,
  inLanguage: lang,
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {
      isHome && lang === defaultLang && !noindex && (
        // Visitors who picked (or whose browser prefers) Russian/Polish land on their
        // language. Runs before paint; crawlers get the English page plus hreflang.
        <script is:inline>
          (function () {
            try {
              var params = new URLSearchParams(location.search);
              var target =
                params.get("lang") ||
                localStorage.getItem("surprice-language") ||
                (navigator.language || "").slice(0, 2).toLowerCase();
              if (target !== "ru" && target !== "pl") return;
              params.delete("lang");
              var qs = params.toString();
              location.replace("/" + target + "/" + (qs ? "?" + qs : "") + location.hash);
            } catch (e) {}
          })();
        </script>
      )
    }
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonicalURL} />}
    {
      !noindex &&
        languages.map((l) => <link rel="alternate" hreflang={l} href={urlFor(l)} />)
    }
    {!noindex && <link rel="alternate" hreflang="x-default" href={urlFor(defaultLang)} />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="SurPrice Bot" />
    <meta property="og:locale" content={ogLocales[lang]} />
    {
      languages
        .filter((l) => l !== lang)
        .map((l) => <meta property="og:locale:alternate" content={ogLocales[l]} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:url" content={canonicalURL} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImageURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400&display=swap"
    />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(softwareAppJsonLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webSiteJsonLd)} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-friendly summary" />
    <script
      defer
      src="https://tools.shefcode.tech/all.js"
      data-site="surprice-bot"
      data-modules="analytics,cookie,replay"
      data-cookie-color="#16c8bd"
      data-cookie-reject-bg="#16c8bd"
    ></script>
  </head>
  <body>
    <Header />
    <main class="min-h-screen">
      <slot />
    </main>
    <Footer />
  </body>
</html>
