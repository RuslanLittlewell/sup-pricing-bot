---
import { localizePath, useAstroTranslations } from "@/i18n";

const { lang, t } = useAstroTranslations(Astro.url);
const home = localizePath(lang, "/");
const year = new Date().getFullYear();
---

<footer class="relative overflow-hidden bg-gradient-to-r from-[#6A5AF9] to-[#049fff] py-16">
  <div class="container relative z-10 mx-auto px-6">
    <div class="flex flex-col gap-10 md:flex-row md:justify-between">
      <div class="max-w-sm">
        <a class="group flex items-center" href={home} aria-label="SurPrice Bot">
          <img
            src="/SPBLogo.svg"
            alt="SurPrice Bot"
            width="246"
            height="64"
            class="h-10 w-auto"
          />
          <span class="ml-3 text-xl font-bold text-white">Sur<span class="text-white/80">Price</span> Bot</span>
        </a>
        <p class="mt-4 text-sm leading-6 text-white/80">
          {t("footer.tagline")}
        </p>
        <a
          href="https://t.me/sur_price_bot/chat"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-6 inline-flex h-11 items-center justify-center rounded-full bg-white px-6 text-sm font-bold text-[#049fff] shadow-lg transition-all duration-300 hover:scale-[1.02] hover:opacity-90"
        >
          {t("hero.cta")}
        </a>
      </div>

      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-white/70">
          {t("footer.linksTitle")}
        </p>
        <ul class="mt-4 space-y-3">
          <li><a class="text-white/85 transition-colors hover:text-white" href={`${home}#features`}>{t("nav.features")}</a></li>
          <li><a class="text-white/85 transition-colors hover:text-white" href={`${home}#pricing`}>{t("nav.pricing")}</a></li>
          <li><a class="text-white/85 transition-colors hover:text-white" href={`${home}#faq`}>{t("nav.faq")}</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-12 border-t border-white/20 pt-6">
      <p class="text-xs leading-5 text-white/60">
        {t("limitations.text")}
      </p>
      <p class="mt-4 text-sm text-white/70">
        © {year} SurPrice Bot. <span>{t("footer.rights")}</span>
      </p>
    </div>
  </div>
</footer>
