ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/price_tracker?sslmode=disable
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/api/telegram/webhook
BOT_USERNAME=your_bot_username
ADMIN_TOKEN=admin-secret
# Credentials for the /api/admin/* dashboard routes (HTTP Basic Auth) — used by the
# admin/ React app instead of an SSH tunnel to the database.
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_SECRET=change-me-in-production
APP_NAME=Price Tracker
APP_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
SCRAPER_COOKIES_FILE=
SCRAPER_PROXY_URL=
# Cloudflare Worker fetch relay — a fallback tier tried right after our own direct fetch
# gets bot-blocked, before paying for a headless render. See cloudflare-relay/README.md
# to deploy it. Leave both empty to disable (PageFetcher just skips this tier).
CF_RELAY_URL=
CF_RELAY_TOKEN=
# Search fallback before SerpAPI. On macOS, port 7000 may be occupied by AirTunes, so
# 7001 is a safer local host port:
# docker run --rm -p 127.0.0.1:7001:7000 karust/openserp:latest serve -a 0.0.0.0 -p 7000
OPEN_SERP_BASE_URL=http://127.0.0.1:7001
OPEN_SERP_ENGINES=google,bing,duckduckgo
OPEN_SERP_API_KEY=
SERPER_API_KEY=
# Optional additional keys (SERPAPI_KEY_2, SERPAPI_KEY_3, ...) are rotated to
# automatically when the current one runs out of searches or gets rejected.
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_KEY_2=
TRIBUTE_API_KEY=your_tribute_api_key_here
TRIBUTE_BASIC_SUBSCRIPTION_ID=
TRIBUTE_PRO_SUBSCRIPTION_ID=
